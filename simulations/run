#!/bin/sh
# Run script for Smart Campus Network Simulation
#
# PREREQUISITES:
#   1. Source OMNeT++ setenv first
#   2. Build INET:  cd ../../inet4.5 && source setenv && make makefiles && make -j$(nproc)
#   3. Build project: cd .. && make makefiles && make -j$(nproc)
#
# Usage:
#   ./run -c Scenario1_NormalTraffic -u Qtenv     # GUI mode
#   ./run -c Scenario5_Firewall -u Cmdenv         # Command-line mode

cd `dirname $0`

# INET shared library (built by INET project)
INET_LIB="../../inet4.5/src/libINET.dll"

# NED path: current dir + project src + INET source
NED_PATH=".:../src:../../inet4.5/src"

# Find project executable
if [ -f "../src/MyFirstNetwork_dbg.exe" ]; then
    PROJ_EXE="../src/MyFirstNetwork_dbg.exe"
elif [ -f "../src/MyFirstNetwork.exe" ]; then
    PROJ_EXE="../src/MyFirstNetwork.exe"
elif [ -f "../out/clang-debug/src/MyFirstNetwork_dbg.exe" ]; then
    PROJ_EXE="../out/clang-debug/src/MyFirstNetwork_dbg.exe"
elif [ -f "../out/clang-release/src/MyFirstNetwork.exe" ]; then
    PROJ_EXE="../out/clang-release/src/MyFirstNetwork.exe"
fi

if [ -n "$PROJ_EXE" ] && [ -f "$INET_LIB" ]; then
    opp_run -l "$INET_LIB" -l "$PROJ_EXE" -n "$NED_PATH" "$@"
elif [ -n "$PROJ_EXE" ]; then
    echo "WARNING: INET library not found at $INET_LIB"
    echo "Build INET first: cd ../../inet4.5 && source setenv && make makefiles && make -j\$(nproc)"
    opp_run -l "$PROJ_EXE" -n "$NED_PATH" "$@"
else
    echo "ERROR: Project executable not found."
    echo "Build first: cd .. && make makefiles && make -j\$(nproc)"
    echo ""
    echo "Attempting fallback with opp_run..."
    if [ -f "$INET_LIB" ]; then
        opp_run -l "$INET_LIB" -n "$NED_PATH" "$@"
    else
        opp_run -n "$NED_PATH" "$@"
    fi
fi
